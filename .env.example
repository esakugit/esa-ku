# --- Database ---
# Local dev: point at your local Postgres (see README "Local database setup").
# Production: use Neon's *pooled* connection string — same driver, same code,
# just a different connection string (packages/db/src/client.ts uses `pg`
# over the standard Postgres wire protocol, which both speak).
DATABASE_URL="postgresql://esa_dev:esa_dev@localhost:5432/esa_platform_dev"
# Production example:
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/esa_platform?sslmode=require"

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- App URL ---
# Used in verification emails. Set to your Vercel deployment URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (Gmail SMTP) ---
# Use a dedicated ESA Gmail account. Enable 2-Step Verification on it, then
# create an App Password at https://myaccount.google.com/apppasswords
# — that 16-character password goes here, NOT the normal Gmail password.
# Leave both blank in dev: sign-up still works and shows a "click to verify"
# link directly in the UI instead of emailing it.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# --- Sign-up email gate ---
# Leave unset in dev to accept any address. Set to your real student domain
# before going live, e.g. "students.ku.ac.ke".
ALLOWED_STUDENT_EMAIL_DOMAIN=""

# --- ESA Badge payment ---
# The till shown on the Badge payment screen — confirm the real values.
NEXT_PUBLIC_ESA_TILL_NUMBER="000000"
NEXT_PUBLIC_ESA_TILL_NAME="ESA Kenyatta University"

# --- File storage ---
# "local" (default) writes uploads to apps/web/.storage and serves them from
# /api/files/... — zero setup, perfect for dev. Switch to "blob" in
# production once you've connected a Vercel Blob store to the project.
STORAGE_DRIVER="local"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"

# --- Web Push ---
# Generate a keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# (run from apps/web, after `pnpm install`, so it can resolve the package).
# Use a DIFFERENT keypair in production than the one in this sandbox.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:esa.kenyatta@gmail.com"
# Mirrors VAPID_PUBLIC_KEY but exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Cron ---
# Shared secret the scheduler (GitHub Actions in production, see README)
# presents to /api/cron/notify. Any long random string.
CRON_SECRET="replace-with-a-long-random-string"
